# VisionGuard AI uses one .env file per service. Copy each example:
#
#   backend/.env.example  -> backend/.env    (MongoDB, JWT, AWS S3, vision service URL)
#   vision/.env.example   -> vision/.env     (YOLO model, port, shared API key)
#   frontend/.env.example -> frontend/.env   (public API URL only)
#
# Summary of every variable:

# ----- backend -----
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/visionguard
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_API_KEY=replace-with-a-shared-secret
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
S3_URL_EXPIRES_SECONDS=3600

# ----- vision -----
VISION_HOST=127.0.0.1
VISION_PORT=8000
# VISION_API_KEY (same value as backend)
YOLO_MODEL=yolov8n.pt
MAX_FRAME_WIDTH=640

# ----- frontend -----
# Only public values: Vite bundles VITE_* variables into browser code.
VITE_API_URL=http://localhost:5000/api
