PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/visionguard
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173

# Python vision service; VISION_API_KEY must match vision/.env
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_API_KEY=replace-with-a-shared-secret

# AWS S3 - server-side only, never exposed to the frontend.
# Without these, events are still saved but with imageStatus "failed".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
S3_URL_EXPIRES_SECONDS=3600
