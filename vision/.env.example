VISION_HOST=127.0.0.1
VISION_PORT=8000
# Must match VISION_API_KEY in backend/.env
VISION_API_KEY=replace-with-a-shared-secret
# Pretrained Ultralytics weights. A bare name (yolov8n.pt) is downloaded
# automatically on first run; a path (models/x.pt) must exist.
YOLO_MODEL=yolov8n.pt
# Frames wider than this are downscaled before inference
MAX_FRAME_WIDTH=640

# Only for local_monitor.py --post
# VISIONGUARD_API_URL=http://localhost:5000/api
# VISIONGUARD_TOKEN=<JWT from POST /api/auth/login>
